module

public import Mathlib.Data.Fintype.Perm
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Order.OrderIsoNat
public import PermutationClosure.ComponentCliques

/-!
# The graph of a set of permutations and its closure

Shvedovsky, Standrik and Bilan, *Economic and Social Institutions: Modelling the
Evolution Paths for the Archaic Society* (2016), appendix, pp. 146–147.
https://doi.org/10.14254/2071-789X.2016/9-2/9
-/

@[expose] public section

namespace PermutationClosure

variable {V : Type*}

/-- Join two distinct points when a permutation in `M` sends one to the other. -/
def graph (M : Set (Equiv.Perm V)) : SimpleGraph V :=
  SimpleGraph.fromRel fun x y => ∃ g ∈ M, g x = y

private theorem reachable_apply (M : Set (Equiv.Perm V)) {g : Equiv.Perm V}
    (hg : g ∈ Subgroup.closure M) : ∀ x, (graph M).Reachable x (g x) := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    intro x
    by_cases h : x = g x
    · simpa only [← h] using (SimpleGraph.Reachable.refl (G := graph M) x)
    · exact SimpleGraph.Adj.reachable (G := graph M) ⟨h, Or.inl ⟨g, hg, rfl⟩⟩
  | one => exact fun _ => .rfl
  | mul f g _ _ hf hg => exact fun x => (hg x).trans (hf (g x))
  | inv g _ hg =>
    intro x
    simpa using (hg (g⁻¹ x)).symm

/-- The vertices reachable from `x` form its orbit under the generated subgroup. -/
theorem reachable_iff (M : Set (Equiv.Perm V)) (x y : V) :
    (graph M).Reachable x y ↔ ∃ g ∈ Subgroup.closure M, g x = y := by
  constructor
  · rintro ⟨walk⟩
    induction walk with
    | nil => exact ⟨1, Subgroup.one_mem _, rfl⟩
    | cons edge _ ih =>
      obtain ⟨g, hg, hy⟩ := ih
      rcases edge.2 with ⟨f, hf, hxy⟩ | ⟨f, hf, hyx⟩
      · exact ⟨g * f, Subgroup.mul_mem _ hg (Subgroup.subset_closure hf),
          by rwa [Equiv.Perm.mul_apply, hxy]⟩
      · exact ⟨g * f⁻¹, Subgroup.mul_mem _ hg (Subgroup.inv_mem _ (Subgroup.subset_closure hf)),
          by simpa [Equiv.Perm.mul_apply, ← hyx] using hy⟩
  · rintro ⟨g, hg, rfl⟩
    exact reachable_apply M hg x

/-- Passing to the generated subgroup turns reachability into adjacency between distinct vertices. -/
theorem closure_graph_eq_fromRel_reachable (M : Set (Equiv.Perm V)) :
    graph (Subgroup.closure M : Set (Equiv.Perm V)) = SimpleGraph.fromRel (graph M).Reachable := by
  apply congrArg SimpleGraph.fromRel
  funext x y
  exact propext (reachable_iff M x y).symm

/-- Graph equality on the original vertices. The supremum is the union of the
edge sets. Each complete graph is included by its component's vertex map. -/
theorem closure_graph_eq_union (M : Set (Equiv.Perm V)) :
    graph (Subgroup.closure M : Set (Equiv.Perm V)) =
      ⨆ C : (graph M).ConnectedComponent, (SimpleGraph.completeGraph C.supp).map Subtype.val := by
  calc
    _ = SimpleGraph.fromRel (graph M).Reachable := closure_graph_eq_fromRel_reachable M
    _ = _ := (graph M).fromRel_reachable_eq_iSup_completeGraph

/-- Two vertices are adjacent in the closure graph exactly when they are distinct
and belong to the same original component. -/
theorem closure_adj_iff_same_component (M : Set (Equiv.Perm V)) (x y : V) :
    (graph (Subgroup.closure M : Set (Equiv.Perm V))).Adj x y ↔
      x ≠ y ∧ (graph M).connectedComponentMk x = (graph M).connectedComponentMk y := by
  rw [closure_graph_eq_fromRel_reachable, SimpleGraph.fromRel_adj, SimpleGraph.ConnectedComponent.eq,
    SimpleGraph.reachable_comm (u := y) (v := x), or_self]

section ProductRounds

open scoped Pointwise

variable {G : Type*} [Group G]

/-- Start with `M`. At each round retain its elements and add all pairwise products. -/
def productRound (M : Set G) : ℕ → Set G
  | 0 => M
  | k + 1 =>
    let A := productRound M k
    A ∪ A * A

private theorem productRound_monotone (M : Set G) : Monotone (productRound M) :=
  monotone_nat_of_le_succ fun _ => Set.subset_union_left

private theorem productRound_subset_closure (M : Set G) (k : ℕ) :
    productRound M k ⊆ Subgroup.closure M := by
  induction k with
  | zero => exact Subgroup.subset_closure
  | succ k ih =>
    exact Set.union_subset ih (Set.mul_subset_iff.mpr fun _ ha _ hb =>
      Subgroup.mul_mem _ (ih ha) (ih hb))

/-- For a nonempty input in a finite group, every sufficiently late round
equals the subgroup generated by the input. -/
theorem productRound_stabilizes [Finite G] (M : Set G) (hM : M.Nonempty) :
    ∃ r, ∀ k ≥ r, productRound M k = (Subgroup.closure M : Set G) := by
  classical
  let := Fintype.ofFinite G
  have mono := productRound_monotone M
  obtain ⟨r, stable⟩ := WellFoundedGT.monotone_chain_condition
    (show ℕ →o Set G from ⟨productRound M, mono⟩)
  let A := productRound M r
  have fixed : productRound M (r + 1) = A := (stable _ (Nat.le_succ r)).symm
  have hMA : M ⊆ A := mono (Nat.zero_le r)
  have closed : A * A ⊆ A := fun _ hx => fixed ▸ Or.inr hx
  have idempotent : A * A = A := by
    apply Set.eq_of_subset_of_card_le closed
    obtain ⟨a, ha⟩ := hM.mono hMA
    let leftMul : A → ↥(A * A) := fun b => ⟨a * b.val, Set.mul_mem_mul ha b.property⟩
    exact Fintype.card_le_of_injective leftMul fun _ _ h =>
      Subtype.ext (mul_left_cancel (congrArg Subtype.val h))
  let K := subgroupOfIdempotent A (hM.mono hMA) idempotent
  have least : Subgroup.closure M ≤ K := (Subgroup.closure_le K).mpr hMA
  have result : A = (Subgroup.closure M : Set G) :=
    Set.Subset.antisymm (productRound_subset_closure M r) least
  exact ⟨r, fun k hk => (stable k hk).symm.trans result⟩

/-- Seeding the process with the identity also covers an empty generating set. -/
theorem productRound_insert_one_stabilizes [Finite G] (M : Set G) :
    ∃ r, ∀ k ≥ r, productRound (insert 1 M) k = (Subgroup.closure M : Set G) := by
  simpa only [Subgroup.closure_insert_one] using
    productRound_stabilizes (insert 1 M) (Set.insert_nonempty _ _)

end ProductRounds

/-- The appendix theorem on `n` points. The multiplication process reaches the
generated subgroup. At that stage there is an edge exactly between distinct
vertices of the same original component. -/
theorem permutation_closure_theorem {n : ℕ} (M : Set (Equiv.Perm (Fin n))) (hM : M.Nonempty) :
    ∃ r, (∀ k ≥ r, productRound M k = (Subgroup.closure M : Set (Equiv.Perm (Fin n)))) ∧
      graph (productRound M r) =
        ⨆ C : (graph M).ConnectedComponent, (SimpleGraph.completeGraph C.supp).map Subtype.val := by
  obtain ⟨r, hr⟩ := productRound_stabilizes M hM
  refine ⟨r, hr, ?_⟩
  rw [hr r le_rfl]
  exact closure_graph_eq_union M

section WithLoops

open Sym2
open scoped Pointwise

/-- The undirected edges on `V` generated by `M`, including loops. An element
of `Sym2 V` is an unordered pair whose endpoints may coincide. -/
def edgesWithLoops (M : Set (Equiv.Perm V)) : Set (Sym2 V) :=
  Sym2.fromRel (r := fun x y => (∃ g ∈ M, g x = y) ∨ (∃ g ∈ M, g y = x))
    ⟨fun _ _ => Or.symm⟩

/-- A loop is present precisely at a fixed point of at least one generator. -/
theorem loop_mem_edgesWithLoops_iff (M : Set (Equiv.Perm V)) (x : V) :
    s(x, x) ∈ edgesWithLoops M ↔ ∃ g ∈ M, g x = x := by
  simp [edgesWithLoops]

/-- Adding the identity adds precisely the missing loops. -/
theorem edgesWithLoops_insert_one (M : Set (Equiv.Perm V)) :
    edgesWithLoops (insert 1 M) = edgesWithLoops M ∪ Sym2.diagSet := by
  ext ⟨x, y⟩
  simp [edgesWithLoops, eq_comm, or_assoc, or_comm, or_left_comm]

/-- Removing loops gives the original simple graph used to compute components. -/
theorem fromEdgeSet_edgesWithLoops (M : Set (Equiv.Perm V)) :
    SimpleGraph.fromEdgeSet (edgesWithLoops M) = graph M := by
  ext x y
  exact and_comm

/-- In the closure graph, even on the diagonal, adjacency is reachability in
the original graph. -/
theorem mem_closure_edgesWithLoops_iff (M : Set (Equiv.Perm V)) (x y : V) :
    s(x, y) ∈ edgesWithLoops (Subgroup.closure M : Set (Equiv.Perm V)) ↔
      (graph M).Reachable x y := by
  change ((∃ g ∈ Subgroup.closure M, g x = y) ∨ (∃ g ∈ Subgroup.closure M, g y = x)) ↔ _
  rw [← reachable_iff M x y, ← reachable_iff M y x,
    SimpleGraph.reachable_comm (u := y) (v := x), or_self]

/-- Each component contributes all its unordered pairs, including its diagonal. -/
theorem closure_edgesWithLoops_eq_iUnion (M : Set (Equiv.Perm V)) :
    edgesWithLoops (Subgroup.closure M : Set (Equiv.Perm V)) =
      ⋃ C : (graph M).ConnectedComponent, C.supp.sym2 := by
  ext ⟨x, y⟩
  simp [mem_closure_edgesWithLoops_iff, ← SimpleGraph.ConnectedComponent.eq, eq_comm]

/-- The first round that adds no new products already equals the generated subgroup. -/
theorem productRound_insert_one_first_stop {G : Type*} [Group G] [Finite G] (M : Set G) :
    let A := productRound (insert 1 M)
    ∃ r, IsLeast {k : ℕ | A (k + 1) = A k} r ∧ A r = (Subgroup.closure M : Set G) := by
  classical
  let A := productRound (insert 1 M)
  obtain ⟨t, ht⟩ := productRound_insert_one_stabilizes M
  have htFixed : A (t + 1) = A t := (ht _ (Nat.le_succ t)).trans (ht t le_rfl).symm
  have stops : ∃ k, A (k + 1) = A k := ⟨t, htFixed⟩
  let r := Nat.find stops
  have first : IsLeast {k : ℕ | A (k + 1) = A k} r := Nat.isLeast_find stops
  have stationary {k : ℕ} (hk : r ≤ k) : A k = A r := by
    induction k, hk using Nat.le_induction with
    | base => rfl
    | succ k _ ih => exact (congrArg (fun S : Set G => S ∪ S * S) ih).trans first.1
  exact ⟨r, first, (stationary (first.2 htFixed)).symm.trans (ht t le_rfl)⟩

/-- With the identity in round zero, the algorithm returns the closure at
its first fixed round for every input. Two points, possibly equal, are then
adjacent exactly when they belong to the same original component. -/
theorem permutation_closure_with_loops {n : ℕ} (M : Set (Equiv.Perm (Fin n))) :
    let A := productRound (insert 1 M)
    ∃ r, IsLeast {k : ℕ | A (k + 1) = A k} r ∧
      A r = (Subgroup.closure M : Set (Equiv.Perm (Fin n))) ∧
      ∀ x y, s(x, y) ∈ edgesWithLoops (A r) ↔
        Relation.ReflTransGen (Sym2.ToRel (edgesWithLoops M)) x y := by
  obtain ⟨r, first, h⟩ := productRound_insert_one_first_stop M
  refine ⟨r, first, h, ?_⟩
  intro x y
  rw [h, mem_closure_edgesWithLoops_iff, ← SimpleGraph.reachable_fromEdgeSet_eq_reflTransGen_toRel,
    fromEdgeSet_edgesWithLoops]

/-- The empty input graph has no edges. Its identity seed has exactly one
loop at each vertex, and round zero is already the first fixed round. -/
theorem empty_input_with_loops (V : Type*) :
    let M : Set (Equiv.Perm V) := ∅
    let A := productRound (insert 1 M)
    IsLeast {k : ℕ | A (k + 1) = A k} 0 ∧ A 0 = {1} ∧
      edgesWithLoops M = ∅ ∧ edgesWithLoops (A 0) = Sym2.diagSet := by
  dsimp only
  have input : edgesWithLoops (∅ : Set (Equiv.Perm V)) = ∅ := by
    ext ⟨x, y⟩
    simp [edgesWithLoops]
  refine ⟨⟨?_, fun _ _ => Nat.zero_le _⟩, ?_, input, ?_⟩
  · show productRound (insert (1 : Equiv.Perm V) ∅) 1 = productRound (insert 1 ∅) 0
    simp [productRound]
  · simp [productRound]
  · rw [productRound, edgesWithLoops_insert_one, input, Set.empty_union]

end WithLoops

end PermutationClosure
